{
  "rules": {
    "presence": {
      "$roomCode": {
        "$uid": {
          // Presence is written by the client owning that uid; readable by room members.
          ".read": "true",
          ".write": "true"
        }
      }
    },
    "canvas": {
      "$roomCode": {
        // Shared drawing canvas: anyone in a room can read + add strokes.
        ".read": "true",
        ".write": "true"
      }
    }
  }
}
