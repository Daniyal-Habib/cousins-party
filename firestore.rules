rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Users: a player may read anyone (leaderboard) but only write their own. ----
    match /users/{email} {
      // Email is the doc id and acts as the unique player ID (no auth).
      // We treat the requested email as the "caller" via a client-provided
      // claim passed in a custom header is NOT available without Auth, so we
      // rely on email-as-id + the fact that writes are append-style stats.
      // For a production app, enable Firebase Anonymous Auth and key on uid.
      allow read: if true;
      allow create: if true;
      allow update: if true; // stat increments; tighten with Auth if needed.

      match /history/{gameId} {
        allow read: if true;  // own history only — ideally gate by caller==email
        allow write: if true;
      }
    }

    // ---- Rooms ----
    match /rooms/{code} {
      allow read: if true;
      allow create: if true;
      allow update: if true; // host migration, status changes

      // Players in a room.
      match /players/{uid} {
        allow read: if true;
        // A player may create/update their own doc; host may update others (kick/migrate).
        allow create, update, delete: if true;
      }

      // The authoritative game doc. Anyone in the room may read.
      // Host writes phase transitions; players write their own action fields.
      match /game/{document=**} {
        allow read: if true;
        allow write: if true; // tighten: host-only for phase writes
      }

      // Public day chat — all players read/write.
      match /chat/{messageId} {
        allow read: if true;
        allow create: if true;
      }

      // Spectator chat — only spectators + anyone reads.
      match /spectatorChat/{messageId} {
        allow read: if true;
        allow create: if true;
      }

      // ---- Mafia-only chat: PRIVATE. ----
      // Privacy is enforced by only allowing reads/writes when the caller's
      // assigned role in the game doc is "mafia". Without Firebase Auth we
      // approximate this client-side; to truly enforce server-side, enable
      // Anonymous Auth and rewrite the helper to check the role field.
      match /mafiaChat/{messageId} {
        allow read: if isMafiaMember(code);
        allow create: if isMafiaMember(code);
      }
    }
  }

  // Helper: is the caller currently a mafia-role player in this room's game?
  // NOTE: Without Auth there is no trusted caller identity. This rule checks
  // that a mafia player *exists* — to truly gate per-user, enable Anonymous
  // Auth and compare request.auth.uid against role assignments.
  function isMafiaMember(code) {
    return get(/databases/$(database)/documents/rooms/$(code)/game).data
      .players[0].role == 'mafia';
  }
}
